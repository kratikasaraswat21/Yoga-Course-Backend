// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//? -------------- We Will Define Some Enums Here --------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum PaymentGateway {
  RAZORPAY
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
  REFUNDED
}

enum RestrictionStatus {
  ACTIVE
  REMOVED
}

enum TokenPurpose {
  USER_PASSWORD_RESET
  ADMIN_PASSWORD_RESET
}

enum VideoStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  ERROR
}

//? ------------ User And Authentication Related Models  ----------
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  orders                   Order[]
  enrollments              Enrollment[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model AuthSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  refreshTokenHash String @unique

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  otpHash String

  attemptsCount Int @default(0)
  maxAttempts   Int @default(5)

  expiresAt   DateTime
  validatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_otps")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  purpose TokenPurpose @default(USER_PASSWORD_RESET)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PdfCourseResource {
  id String @id @default(uuid())

  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  price              Float
  discount           Int
  totalPayableAmount Float

  isAvailableForFree Boolean

  pdfFileName String

  fileUrl      String
  thumbnailUrl String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("pdf_course_resource")
}

model AffiliateProducts {
  id String @id @default(uuid())

  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  productsLink String
  buttonTitle  String
  thumbnailUrl String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("affiliate_products")
}

model YogaCourse {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  price              Decimal @default(0) @db.Decimal(10, 2)
  discount           Int     @default(0)
  totalPayableAmount Decimal @default(0) @db.Decimal(10, 2)

  thumbnailUrl String
  thumbnailId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseVideos CourseVideo[]
  orders       Order[]
  enrollments  Enrollment[]

  @@map("yoga_courses")
}

model Order {
  id String @id @default(uuid())

  userId   String
  courseId String
  user     User       @relation(fields: [userId], references: [id])
  course   YogaCourse @relation(fields: [courseId], references: [id])

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")
  status   OrderStatus @default(CREATED)

  razorpayOrderId String @unique

  payment    Payment?
  enrollment Enrollment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([courseId, status])
  @@map("orders")
}

model Payment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gateway PaymentGateway @default(RAZORPAY)
  status  PaymentStatus  @default(CREATED)

  razorpayPaymentId String? @unique
  razorpaySignature String?
  method             String?
  failureReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

model RazorpayWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@map("razorpay_webhook_events")
}

model Enrollment {
  id String @id @default(uuid())

  userId   String
  courseId String
  orderId  String @unique
  user     User       @relation(fields: [userId], references: [id])
  course   YogaCourse @relation(fields: [courseId], references: [id])
  order    Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("enrollments")
}

model CourseVideo {
  id          String  @id @default(uuid())
  title       String
  description String?

  originalFileName String
  fileType         String
  fileSize         BigInt

  cloudflareVideoUid   String?     @unique
  status               VideoStatus @default(PENDING)
  readyToStream        Boolean     @default(false)
  processingPercentage Float       @default(0)

  durationSeconds Float?
  width           Int?
  height          Int?
  hlsUrl          String?
  dashUrl         String?

  isCustomThumbnail Boolean @default(false)

  thumbnailUrl String
  thumbnailId  String

  errorCode    String?
  errorMessage String?

  sortOrder Int @default(0)

  yogaCourseId String

  yogaCourse YogaCourse @relation(fields: [yogaCourseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yogaCourseId])
  @@index([yogaCourseId, sortOrder])
  @@map("course_videos")
}
