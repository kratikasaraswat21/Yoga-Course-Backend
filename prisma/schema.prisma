// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//? -------------- We Will Define Some Enums Here --------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum PaymentGateway {
  RAZORPAY
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
  REFUNDED
}

enum RestrictionStatus {
  ACTIVE
  REMOVED
}

enum TokenPurpose {
  USER_PASSWORD_RESET
  ADMIN_PASSWORD_RESET
}

enum OfferType {
  NONE
  DISCOUNT
  PRELAUNCH
}

enum VideoStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  ERROR
}

//? ------------ User And Authentication Related Models  ----------
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  orders                  Order[]
  enrollments             Enrollment[]
  courseReviews           CourseReview[]
  courseVideoRatings      CourseVideoRating[]
  courseVideoCompletions  CourseVideoCompletion[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model AuthSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  refreshTokenHash String @unique

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  otpHash String

  attemptsCount Int @default(0)
  maxAttempts   Int @default(5)

  expiresAt   DateTime
  validatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_otps")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  purpose TokenPurpose @default(USER_PASSWORD_RESET)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PdfCourseResource {
  id String @id @default(uuid())

  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  price              Float
  discount           Float
  totalPayableAmount Float

  isAvailableForFree Boolean

  pdfFileName String

  fileUrl      String
  thumbnailUrl String

  sortOrder Int @default(0)

  orders      Order[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("pdf_course_resource")
}

// Student feedback screenshots (Cloudinary) shown on the home page and course landing pages.
model InstagramFeedbackImage {
  id String @id @default(uuid())

  imageUrl String
  publicId String
  altText  String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("instagram_feedback_images")
}

model AffiliateProducts {
  id String @id @default(uuid())

  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  productsLink String
  buttonTitle  String
  thumbnailUrl String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("affiliate_products")
}

model YogaCourse {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique // public landing page URL: /courses/<slug>
  description String?
  status      CourseStatus @default(DRAFT)

  price              Float @default(0)
  discount           Float @default(0)
  totalPayableAmount Float @default(0)

  // Prelaunch offer. Dates are stored as 00:00 IST of the chosen day; the end date is exclusive.
  prelaunchEnabled       Boolean   @default(false)
  prelaunchStartAt       DateTime?
  prelaunchEndAt         DateTime?
  prelaunchDiscount      Float     @default(0)
  prelaunchPayableAmount Float     @default(0)

  landingPageEnabled Boolean @default(false)

  // Buyers must complete each video before the next one opens.
  sequentialUnlock Boolean @default(false)

  thumbnailUrl String
  thumbnailId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseVideos CourseVideo[]
  orders       Order[]
  enrollments  Enrollment[]
  reviews      CourseReview[]

  landingContent CourseLandingContent?
  videoGroups    CourseVideoGroup[]

  @@index([prelaunchStartAt])
  @@index([prelaunchEndAt])
  @@map("yoga_courses")
}

model CourseLandingContent {
  id       String     @id @default(uuid())
  courseId String     @unique
  course   YogaCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Every editable section and text of the public page (see src/utils/course-landing.util.js).
  content Json @default("{}")

  // Course trailer on Cloudflare Stream. Public (not signed): anyone can watch it on the landing page.
  trailerVideoUid        String?      @unique
  trailerStatus          VideoStatus?
  trailerHlsUrl          String?
  trailerThumbnailUrl    String? // Cloudflare's automatic thumbnail
  trailerDurationSeconds Float?
  trailerFileName        String?
  // Optional custom thumbnail (Cloudflare Images) shown before the trailer plays.
  trailerPosterUrl       String?
  trailerPosterId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("course_landing_contents")
}

model Order {
  id String @id @default(uuid())

  userId      String
  courseId    String?
  pdfCourseId String?
  user        User               @relation(fields: [userId], references: [id])
  course      YogaCourse?        @relation(fields: [courseId], references: [id])
  pdfCourse   PdfCourseResource? @relation(fields: [pdfCourseId], references: [id])

  amount   Decimal     @db.Decimal(10, 2)
  currency String      @default("INR")
  status   OrderStatus @default(CREATED)

  offerType       OfferType @default(NONE)
  discountPercent Float     @default(0)

  razorpayOrderId String @unique

  payment    Payment?
  enrollment Enrollment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([courseId, status])
  @@index([pdfCourseId, status])
  @@map("orders")
}

model Payment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gateway PaymentGateway @default(RAZORPAY)
  status  PaymentStatus  @default(CREATED)

  razorpayPaymentId String? @unique
  razorpaySignature String?
  method            String?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

model RazorpayWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@map("razorpay_webhook_events")
}

model Enrollment {
  id String @id @default(uuid())

  userId      String
  courseId    String?
  pdfCourseId String?
  orderId     String?            @unique
  user        User               @relation(fields: [userId], references: [id])
  course      YogaCourse?        @relation(fields: [courseId], references: [id])
  pdfCourse   PdfCourseResource? @relation(fields: [pdfCourseId], references: [id])
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokeReason String?

  isPrelaunchPurchase Boolean @default(false)

  // Set when the purchase confirmation / "course is live" email has been sent (claimed before sending,
  // so it is sent once). The daily job retries a purchase email that is still null.
  purchaseEmailSentAt DateTime?
  liveEmailSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@unique([userId, pdfCourseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@index([pdfCourseId, status])
  @@map("enrollments")
}

model CourseVideo {
  id          String  @id @default(uuid())
  title       String
  description String?

  originalFileName String
  fileType         String
  fileSize         BigInt

  cloudflareVideoUid   String?     @unique
  status               VideoStatus @default(PENDING)
  readyToStream        Boolean     @default(false)
  processingPercentage Float       @default(0)

  durationSeconds Float?
  width           Int?
  height          Int?
  hlsUrl          String?
  dashUrl         String?

  isCustomThumbnail Boolean @default(false)

  thumbnailUrl String
  thumbnailId  String

  errorCode    String?
  errorMessage String?

  sortOrder Int @default(0)

  // null = visible as soon as the video is READY. Otherwise 00:00 IST of the release day.
  releaseAt DateTime?

  // Optional week/group, e.g. "Week 1". null = not in any group.
  groupId String?
  group   CourseVideoGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  yogaCourseId String

  yogaCourse  YogaCourse              @relation(fields: [yogaCourseId], references: [id], onDelete: Cascade)
  ratings     CourseVideoRating[]
  completions CourseVideoCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yogaCourseId])
  @@index([yogaCourseId, sortOrder])
  @@index([yogaCourseId, releaseAt])
  @@index([releaseAt])
  @@index([groupId])
  @@map("course_videos")
}

// Groups a course's videos, e.g. "Week 1: Foundations". Deleting a group never deletes its videos.
model CourseVideoGroup {
  id           String     @id @default(uuid())
  yogaCourseId String
  yogaCourse   YogaCourse @relation(fields: [yogaCourseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  sortOrder   Int     @default(0)

  videos CourseVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yogaCourseId, sortOrder])
  @@map("course_video_groups")
}

model CourseReview {
  id       String  @id @default(uuid())
  userId   String
  courseId String
  rating   Float
  comment  String?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course YogaCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_reviews")
}

model CourseVideoRating {
  id      String @id @default(uuid())
  userId  String
  videoId String
  rating  Float

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video CourseVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("course_video_ratings")
}

model CourseVideoCompletion {
  id          String   @id @default(uuid())
  userId      String
  videoId     String
  completedAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video CourseVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("course_video_completions")
}
