// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//? -------------- We Will Define Some Enums Here --------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum PaymentGateway {
  RAZORPAY
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
  REFUNDED
}

enum RestrictionStatus {
  ACTIVE
  REMOVED
}

enum TokenPurpose {
  USER_PASSWORD_RESET
  ADMIN_PASSWORD_RESET
}

//? ------------ User And Authentication Related Models  ----------
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model AuthSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  refreshTokenHash String @unique

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  otpHash String

  attemptsCount Int @default(0)
  maxAttempts   Int @default(5)

  expiresAt   DateTime
  validatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_otps")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  purpose TokenPurpose @default(USER_PASSWORD_RESET)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PdfCourseResource {
  id String @id @default(uuid())

  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  price              Float
  discount           Int
  totalPayableAmount Float

  isAvailableForFree Boolean

  pdfFileName String

  fileUrl      String
  thumbnailUrl String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("pdf_course_resource")
}

model AffiliateProducts {
  id String @id @default(uuid())

  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  productsLink String
  buttonTitle  String
  thumbnailUrl String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("affiliate_products")
}
